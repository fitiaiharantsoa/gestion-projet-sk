{% extends 'base.html.twig' %}

{% block title %}Fichiers des projets{% endblock %}

{% block body %}
    <h1>Liste des fichiers de projets</h1>

    <a href="{{ path('app_projet_file_new') }}" class="btn btn-primary">Ajouter un fichier</a>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Date Upload</th>
                <th>Projet</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for file in project_files %}
            <tr>
                <td>{{ file.id }}</td>
                <td>{{ file.type }}</td>
                <td>{{ file.dateUpload ? file.dateUpload|date('d/m/Y') : '' }}</td>
                <td>{{ file.projet ? file.projet.titre : 'Aucun projet' }}</td>
                <td>
                    <a href="{{ path('app_projet_file_show', {'id': file.id}) }}">Voir</a>
                    <a href="{{ path('app_projet_file_edit', {'id': file.id}) }}">Modifier</a>
                    <form method="post" action="{{ path('app_projet_file_delete', {'id': file.id}) }}" style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ file.id) }}">
                        <button class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun fichier trouvé.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
