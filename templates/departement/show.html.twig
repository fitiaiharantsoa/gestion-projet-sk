{% extends 'base.html.twig' %}

{% block title %}Département{% endblock %}

{% block body %}
    <h1>Département</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ departement.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ departement.nom }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_departement_index') }}">Retour</a>

    <a href="{{ path('app_departement_edit', {'id': departement.id}) }}">Modifier</a>

    {{ include('departement/_delete_form.html.twig') }}
{% endblock %}
