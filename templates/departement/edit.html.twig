{% extends 'base.html.twig' %}

{% block title %}Modifier Département{% endblock %}

{% block body %}
    <h1 class="text-center mb-4" style="font-size:1.5rem; font-weight:600;">Modifier Département</h1>

    <div class="d-flex justify-content-center mb-4">
        {{ include('departement/_form.html.twig', {'button_label': 'Enregistrer'}) }}
    </div>

    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path('app_departement_index') }}" class="btn btn-back-rounded">Retour</a>
        {{ include('departement/_delete_form.html.twig') }}
    </div>

    <style>
        .btn-back-rounded {
            background-color: #60a5fa; /* bleu doux */
            color: white;
            border: none;
            padding: 0.4rem 0.9rem;
            font-size: 0.875rem;
            border-radius: 1rem;
            transition: all 0.2s;
            text-decoration: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .btn-back-rounded:hover {
            background-color: #3b82f6;
            color: white;
        }
        .btn-delete {
            background-color: #facc15; /* jaune */
            color: white;
            border-radius: 0.5rem;
            padding: 0.4rem 0.8rem;
            font-size: 0.875rem;
            border: none;
            transition: all 0.2s;
        }
        .btn-delete:hover {
            background-color: #eab308;
            color: white;
        }
    </style>
{% endblock %}
