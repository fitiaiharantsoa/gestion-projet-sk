{% extends 'base.html.twig' %}

{% block title %}Notification{% endblock %}

{% block body %}
<h2 class="text-center mb-4" style="font-size:1.6rem; font-weight:600;">Notification</h2>

<div class="table-responsive">
    <table class="table table-modern">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ notification.id }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ notification.message }}</td>
            </tr>
            <tr>
                <th>Vu</th>
                <td>{{ notification.seen ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ notification.createdAt ? notification.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="mt-3 d-flex justify-content-between">
    <a href="{{ path('app_notification_index') }}" class="btn btn-back">Retour</a>
    <div>
        <a href="{{ path('app_notification_edit', {'id': notification.id}) }}" class="btn btn-edit">Modifier</a>
        {{ include('notification/_delete_form.html.twig') }}
    </div>
</div>

<style>
/* Tableau stylé */
.table-modern {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 0.5rem;
}

.table-modern tbody tr {
    background-color: #ffffff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.08);
    transition: transform 0.2s;
}

.table-modern tbody tr:hover {
    transform: translateY(-2px);
}

.table-modern th, .table-modern td {
    padding: 0.75rem 1rem;
    vertical-align: middle;
}

/* Boutons */
.btn-back {
    background-color: #60a5fa;
    color: white;
    border-radius: 0.5rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.2s;
}

.btn-back:hover {
    background-color: #3b82f6;
    color: white;
}

.btn-edit {
    background-color: #facc15;
    color: white;
    border-radius: 0.5rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    text-decoration: none;
    margin-right: 0.5rem;
}

.btn-edit:hover {
    background-color: #eab308;
}

.btn-delete {
    background-color: #f59e0b;
    color: white;
    border-radius: 0.5rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-delete:hover {
    background-color: #d97706;
}
</style>
{% endblock %}
