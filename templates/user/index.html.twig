{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold">Liste des utilisateurs</h1>
        <a href="{{ path('user_new') }}" class="btn btn-primary rounded-3 py-2">
            ➕ Créer un nouvel utilisateur
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Prénom</th>
                    <th>Nom</th>
                    <th>Rôles</th>
                    <th>Vérifié</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.prenom }}</td>
                        <td>{{ user.nom }}</td>
                        <td>{{ user.roles|join(', ') }}</td>
                        <td>
                            {% if user.isVerified %}
                                <span class="badge bg-success">Oui</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">Non</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <a href="{{ path('user_profile', { id: user.id }) }}" class="btn btn-sm btn-outline-primary me-1">Voir</a>
                            <a href="{{ path('user_edit', { id: user.id }) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
