{% extends 'base.html.twig' %}

{% block title %}Liste des projets en cours{% endblock %}

{% block body %}
<h2 class="text-center my-5">Vos projets</h2>

{# Résumé des progressions selon rôle #}
{% if 'ROLE_PDG' in app.user.roles %}
<div class="d-flex flex-wrap justify-content-around mb-5 gap-4">
    <div class="summary-card text-center p-3">
        <h4>Progression globale: {{ progressionGlobale }}%</h4>
        <h5>Nombre de projets : {{ total_projet }}</h5>
        <canvas id="nbr_projet_chart" width="200" height="200"></canvas>
    </div>
    <div class="summary-card text-center p-3" style="width: 350px;">
        <h4>Progression par département:</h4>
        <canvas id="chart"></canvas>
    </div>
</div>
{% endif %}

{% if 'ROLE_USER' in app.user.roles %}
<h4 class="text-center mb-4">Progression totale: {{ progressionParUser[app.user.id]|default(0) }}%</h4>
{% endif %}

{# Bouton Nouveau Projet #}
<div class="d-flex flex-wrap gap-4 justify-content-center mb-5">
    <div class="card new-project-card text-center p-3" style="width: 18rem; height: 18rem; display: flex; align-items: center; justify-content: center;">
        <a href="{{ path('app_project_new') }}" class="text-decoration-none d-flex flex-column align-items-center">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" fill="#60a5fa" opacity="0.3"/>
                <path d="M16 11.25H12.75V8C12.75 7.59 12.41 7.25 12 7.25C11.59 7.25 11.25 7.59 11.25 8V11.25H8C7.59 11.25 7.25 11.59 7.25 12C7.25 12.41 7.59 12.75 8 12.75H11.25V16C11.25 16.41 11.59 16.75 12 16.75C12.41 16.75 12.75 16.41 12.75 16V12.75H16C16.41 12.75 16.75 12.41 16.75 12C16.75 11.59 16.41 11.25 16 11.25Z" fill="#292D32"/>
            </svg>
            <span class="mt-2 fw-bold">Nouveau projet</span>
        </a>
    </div>

    {# Affichage des projets existants #}
    {% for project in projects %}
        {% set tasks = project.tasks %}
        {% set avgProgress = tasks|length > 0 ? (tasks|map(t => t.progression ?: 0)|reduce((a,b) => a+b)/tasks|length)|round : 0 %}

        <div class="card project-card" style="width: 18rem; height: 18rem;">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title">{{ project.titre }}</h5>
                    <h6 class="card-subtitle mb-2 text-muted">{{ project.statut }}</h6>
                    <p class="card-text" style="min-height: 8rem;">{{ project.description }}</p>
                </div>
                <div>
                    <div class="progress mb-2">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: {{ avgProgress }}%">
                            {{ avgProgress }}%
                        </div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('project_kanban', {'id': project.id}) }}" class="btn btn-success btn-sm">Voir</a>
                        <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-center">Aucun projet en cours.</p>
    {% endfor %}
</div>

{# Pagination #}
<div class="d-flex justify-content-center mt-5">
    <nav>
        <ul class="pagination">
            {% if current_page > 1 %}
                <li class="page-item"><a class="page-link" href="{{ path('app_project_index', {'page': current_page - 1}) }}">&laquo;</a></li>
            {% endif %}
            {% for i in 1..total_pages %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link" href="{{ path('app_project_index', {'page': i}) }}">{{ i }}</a>
                </li>
            {% endfor %}
            {% if current_page < total_pages %}
                <li class="page-item"><a class="page-link" href="{{ path('app_project_index', {'page': current_page + 1}) }}">&raquo;</a></li>
            {% endif %}
        </ul>
    </nav>
</div>

{# ChartJS #}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% if 'ROLE_PDG' in app.user.roles %}
<script>
const chart_projet_element = document.getElementById("nbr_projet_chart")
new Chart(chart_projet_element, {
    type: 'doughnut',
    data: {
        labels: ['A faire','En cours','Bloqué','Terminé'],
        datasets: [{
            label: "Répartition des projets",
            data: ['{{ total_a_faire }}','{{ total_encours }}','{{ total_bloque }}','{{ total_termine }}'],
            backgroundColor: ['#A4B494','#BEC5AD','#3B5249','#519872']
        }]
    }
});

const mc = document.getElementById('chart')
new Chart(mc, {
    type: 'doughnut',
    data: {
        labels: [{% for depId, prog in progressionParDepartement %}'{{ nomdep[depId]|default('Défaut') }}',{% endfor %}],
        datasets: [{
            label: 'Progression par département',
            data: [{% for depId, prog in progressionParDepartement %}{{ prog }},{% endfor %}],
            backgroundColor: [{% for depId, prog in progressionParDepartement %}'{{ couleur[depId]|default('red') }}',{% endfor %}]
        }]
    }
});
</script>
{% endif %}

<style>
.project-card, .new-project-card {
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    border-radius: 1rem;
    padding: 1rem;
}
.btn-success { background-color: #34d399; color: white; }
.btn-success:hover { background-color: #10b981; color: white; }
.btn-warning { background-color: #facc15; color: white; }
.btn-warning:hover { background-color: #eab308; color: white; }
.summary-card { background: #f3f4f6; border-radius: 1rem; box-shadow: 0 2px 5px rgba(0,0,0,0.1); width: 250px; }
</style>
{% endblock %}
