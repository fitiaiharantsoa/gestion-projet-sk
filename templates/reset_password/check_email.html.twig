{% extends 'base.html.twig' %}

{% block title %}Email envoyé{% endblock %}

{% block body %}
<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-lg border-0 p-5 w-100" style="max-width: 500px; border-radius: 15px;">

        <!-- Logo et titre -->
        <div class="text-center mb-4">
            <img src="{{ asset('images/sk-logo.png') }}" alt="Logo SK"
                 style="max-width: 80px; height: auto; margin-bottom: 10px;">
            <h3 class="fw-bold">📧 Email envoyé</h3>
            <p class="text-muted small">
                Un email a été envoyé avec un lien pour réinitialiser votre mot de passe.
            </p>
        </div>

        <!-- Contenu principal -->
        <div class="mb-4">
            <p>
                Si un compte correspondant à votre adresse email existe, un email vient de vous être envoyé contenant un lien pour réinitialiser votre mot de passe.
            </p>
            <p>
                Ce lien expirera dans <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
            </p>
            <p>
                Si vous ne recevez pas l'email, veuillez vérifier votre dossier spam ou <a href="{{ path('app_forgot_password_request') }}">réessayer</a>.
            </p>
        </div>

        <!-- Bouton retour -->
        <div class="text-center">
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary rounded-3 py-2 fw-bold">
                🔙 Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
