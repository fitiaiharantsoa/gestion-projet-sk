{% extends 'base.html.twig' %}

{% block title %}Département {{ departement.nom }}{% endblock %}

{% block body %}
    <h1>Département {{ departement.nom }}</h1>

    <div class="" style="display: flex; gap: 10px;" >
        <h4 id="projets" style="text-decoration: underline;" class="btn">Projets</h4>
        <h4 id="membre" class="btn">Membres</h4>
    </div>
    <table class="table" id="liste_projet" >
        <tbody>
            <tr>
                <th>Id</th>
                <th>Projet</th>
                <th>Résponsable</th>
            </tr>
            {% for row in projet %}
            <tr>
                <td>{{ row.id }} </td>
                <td><a href="{{ path('project_kanban', {'id': row.id}) }}" class="btn" title="Détails du projet">{{ row.titre }} </a></td>
                <td><a href="{{ path('user_profile', {'id': row.responsable.id}) }} " class="btn" title="Détails du responsable">{{row.responsable}}</a> </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    
    <table class="table" id="liste_membre" style="display: none;">
        <tbody>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Nom</th>
                <th>Prenom</th>
            </tr>
            {% for row in membres %}
            <tr>
                <td>{{row.id}}</td>
                <td>{{row.email}}</td>
                <td>{{row.nom}}</td>
                <td>{{row.prenom}}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('app_departement_index') }}">Retour</a>

    <a href="{{ path('app_departement_edit', {'id': departement.id}) }}">Modifier</a>
    <script>
        document.getElementById('projets').addEventListener('click', (e)=>{
            document.getElementById('liste_projet').style.display = 'table';
            
            document.getElementById('liste_membre').style.display = 'none';
            document.getElementById('membre').style.textDecoration = 'none';
            document.getElementById('projets').style.textDecoration = 'underline';
            e.preventDefault();
        })
        document.getElementById('membre').addEventListener('click', (e)=>{
            document.getElementById('liste_membre').style.display = 'table';
            
            document.getElementById('liste_projet').style.display = 'none';
            document.getElementById('membre').style.textDecoration = 'underline';
            document.getElementById('projets').style.textDecoration = 'none';
            e.preventDefault();
        })
    </script>
    {{ include('departement/_delete_form.html.twig') }}
{% endblock %}
