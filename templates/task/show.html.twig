{% extends 'base.html.twig' %}

{% block title %}Tâche{% endblock %}

{% block body %}
    <h1>Tâche</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ task.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ task.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ task.description }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ task.statut }}</td>
            </tr>
            <tr>
                <th>Date Echéance</th>
                <td>{{ task.dateEcheance ? task.dateEcheance|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Priorité</th>
                <td>{{ task.priorite }}</td>
            </tr>
            <tr>
                <th>Progréssion</th>
                <td>{{ task.progression }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ task.createdAt ? task.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Dèrnière Modification</th>
                <td>{{ task.updatedAt ? task.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_task_index') }}">Retour</a>

    <a href="{{ path('app_task_edit', {'id': task.id}) }}">edit</a>

    {{ include('task/_delete_form.html.twig') }}
{% endblock %}
