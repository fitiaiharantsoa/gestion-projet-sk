{% extends 'base.html.twig' %}

{% block title %}Modifier Notification{% endblock %}

{% block body %}
<h2 class="text-center mb-4" style="font-size:1.6rem; font-weight:600;">Modifier Notification</h2>

<div class="d-flex justify-content-center">
    <form method="post" class="form-container">
        <!-- Message -->
        <div class="form-floating mb-3">
            {{ form_widget(form.message, {'attr': {'class': 'form-control', 'placeholder': 'Message'}}) }}
            {{ form_label(form.message) }}
            {{ form_errors(form.message) }}
        </div>

        <!-- Destinataire -->
        <div class="form-floating mb-3">
            {{ form_widget(form.recipient, {'attr': {'class': 'form-select'}}) }}
            {{ form_label(form.recipient) }}
            {{ form_errors(form.recipient) }}
        </div>

        <button class="btn btn-primary btn-center">{{ button_label|default('Enregistrer') }}</button>
    </form>
</div>

<div class="mt-3 text-end">
    <a href="{{ path('app_notification_index') }}" class="btn btn-back">Retour</a>
</div>

{{ include('notification/_delete_form.html.twig') }}

<style>
/* Conteneur du formulaire */
.form-container {
    width: 100%;
    max-width: 500px;
    background-color: #ffffff;
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

/* Champs flottants */
.form-floating input,
.form-floating textarea,
.form-floating select {
    height: 3rem;
    font-size: 0.9rem;
}

/* Bouton centré */
.btn-center {
    display: block;
    width: 50%;
    margin: 1rem auto 0 auto;
    background-color: #60a5fa;
    color: white;
    border: none;
    border-radius: 0.5rem;
    padding: 0.5rem;
    font-size: 1rem;
    transition: all 0.2s;
}

.btn-center:hover {
    background-color: #3b82f6;
}

/* Bouton retour */
.btn-back {
    background-color: #60a5fa;
    color: white;
    border-radius: 0.5rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.2s;
}

.btn-back:hover {
    background-color: #3b82f6;
    color: white;
}
</style>
{% endblock %}
