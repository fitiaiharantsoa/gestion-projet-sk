{% extends 'base.html.twig' %}

{% block title %}Nouveau fichier projet{% endblock %}

{% block body %}
<h2 class="text-center mb-4" style="font-size:1.6rem; font-weight:600;">Ajouter un nouveau fichier au projet</h2>

<div class="d-flex justify-content-center">
    <div style="width: 400px;">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary mt-2">Enregistrer</button>
        {{ form_end(form) }}

        <div class="mt-3 text-end">
            <a href="{{ path('app_project_file_index') }}" class="btn btn-back">Retour à la liste</a>
        </div>
    </div>
</div>

<style>
    .btn-back {
        background-color: #60a5fa;
        color: white;
        border-radius: 0.5rem;
        padding: 0.4rem 0.9rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-back:hover {
        background-color: #3b82f6;
        color: white;
    }

    .form-control, .form-select {
        border-radius: 0.4rem;
        padding: 0.5rem;
    }

    .btn-primary {
        padding: 0.5rem 1rem;
        border-radius: 0.4rem;
        font-size: 0.9rem;
        transition: background-color 0.2s;
    }

    .btn-primary:hover {
        background-color: #0d6efdcc;
    }
</style>
{% endblock %}
