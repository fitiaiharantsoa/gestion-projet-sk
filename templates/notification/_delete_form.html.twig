<form method="post" action="{{ path('app_notification_delete', {'id': notification.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette notification ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ notification.id) }}">
    <button class="btn btn-delete">Supprimer</button>
</form>

<style>
.btn-delete {
    background-color: #facc15; /* jaune doux */
    color: white;
    padding: 0.4rem 0.9rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    border: none;
    transition: all 0.2s;
}

.btn-delete:hover {
    background-color: #eab308; /* jaune plus foncé au hover */
    color: white;
}
</style>
