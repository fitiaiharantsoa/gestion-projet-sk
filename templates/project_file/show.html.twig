{% extends 'base.html.twig' %}

{% block title %}Détail du fichier{% endblock %}

{% block body %}
    <h1>Détail du fichier projet</h1>

    <ul>
        <li><strong>Type :</strong> {{ projet_file.type }}</li>
        <li><strong>Date :</strong> {{ projet_file.dateUpload ? projet_file.dateUpload|date('d/m/Y') : '' }}</li>
        <li><strong>Projet :</strong> {{ projet_file.projet.titre }}</li>
    </ul>

    <a href="{{ path('app_projet_file_edit', {'id': projet_file.id}) }}" class="btn btn-warning">Modifier</a>
    <form method="post" action="{{ path('app_projet_file_delete', {'id': projet_file.id}) }}" style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ projet_file.id) }}">
        <button class="btn btn-danger">Supprimer</button>
    </form>

    <a href="{{ path('app_projet_file_index') }}" class="btn btn-secondary">Retour à la liste</a>
{% endblock %}
