{% extends 'base.html.twig' %}

{% block title %}Modifier Utilisateur{% endblock %}

{% block body %}
<h1>Modifier le profil utilisateur</h1>

{{ form_start(form) }}
    {# {{ form_widget(form) }} #}
    <div class="form-floating mb-3">
        {{ form_widget(form.email) }}
        {{ form_label(form.email) }}
        {{ form_errors(form.email) }}
    </div>
    <div class="mb-3">

        {{ form_label(form.roles) }}
       {% for choice in form.roles %}
            <div class="form-check">
                {{form_widget(choice)}}
                {{form_label(choice)}}
                {{form_errors(choice)}}
            </div>
       {% endfor %}
    </div>
        {{ form_row(form.isVerified) }}
        {{ form_row(form.isEmailAuthEnabled) }}
    <button class="btn btn-primary">Enregistrer</button>
{{ form_end(form) }}

<a href="{{ path('user_index') }}">← Retour à la liste</a>
{% endblock %}
