{{ form_start(form) }}
    {# {{ form_widget(form) }} #}
  
    <div class="row">
        <div class="col">
            <div class="form-floating mb-3">
                {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder':''}}) }}
                {{ form_label(form.titre) }}
                {{ form_errors(form.titre) }}
            </div>
           </div>
            <div class="col">
                <div class="form-floating mb-3">
                    {{ form_widget(form.dateEcheance, {'attr': {'class': 'form-control'}}) }}
                    {{ form_label(form.dateEcheance) }}
                    {{ form_errors(form.dateEcheance) }}
                </div>
            </div>
    </div>
    <div class="form-floating mb-3">
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder':''}}) }}
        {{ form_label(form.description) }}
        {{ form_errors(form.description) }}
    </div>
    
    <div class="row">
        <div class="col">
            <div class="form-floating mb-3">
                {{ form_widget(form.assigne, {'attr': {'class': 'form-select'}}) }}
                {{ form_label(form.assigne) }}
                {{ form_errors(form.assigne) }}
            </div>
        </div>
       <div class="col">
        <div class="form-floating mb-3">
            {{ form_widget(form.priorite, {'attr': {'class': 'form-select'}}) }}
            {{ form_label(form.priorite) }}
            {{ form_errors(form.priorite) }}
        </div>
    </div>
   </div>
   <div class="row">
    <div class="col">
        <div class="form-floating mb-3">
            {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
            {{ form_label(form.statut) }}
            {{ form_errors(form.statut) }}
        </div>
    </div>
    <div class="col">
        <div class="form-floating mb-3">
            {{ form_widget(form.project, {'attr': {'class': 'form-select'}}) }}
            {{ form_label(form.project) }}
            {{ form_errors(form.project) }}
        </div>
    </div>
   </div>
    <div class=" mb-3">
        {{ form_label(form.progression) }}
        {{ form_widget(form.progression, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.progression) }}
    </div>
   
   
    <button class="btn btn-outline-primary">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
