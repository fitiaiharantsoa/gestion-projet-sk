{% extends 'base.html.twig' %}

{% block title %}Email Confirmé{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center align-items-center" style="height: 70vh;">
        <div class="text-center">
            <h1 class="mb-4" style="font-size: 2rem;">✅ Votre adresse email a été confirmée</h1>
            <p class="mb-4">Merci d'avoir vérifié votre adresse email. Vous pouvez maintenant vous connecter.</p>
            <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">Se connecter</a>
        </div>
    </div>
{% endblock %}
