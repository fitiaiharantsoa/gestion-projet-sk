{% extends 'base.html.twig' %}

{% block title %}Modifier BU{% endblock %}

{% block body %}
<div class="container py-4">

    <!-- Titre -->
    <h1 class="text-center text-dark mb-4" style="font-size: 1.6rem;">Modifier BU</h1>

    <!-- Formulaire -->
    <div class="card shadow-sm p-4 mb-4">
        {{ include('bu/_form.html.twig', {'button_label': 'Enregistrer'}) }}
    </div>

    <!-- Boutons bas -->
    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path('app_b_u_index') }}" class="btn btn-back btn-sm">Retour</a>

        {% if 'ROLE_PDG' in app.user.roles %}
            {{ include('bu/_delete_form.html.twig') }}
        {% endif %}
    </div>

</div>

<style>
/* Bouton Retour stylé */
.btn-back {
    background-color: #60a5fa; /* bleu doux */
    color: white;
    border: none;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
}
.btn-back:hover {
    background-color: #3b82f6; 
    color: white;
}

/* Bouton Supprimer stylé */
.btn-delete {
    background-color: #facc15; /* jaune */
    color: white;
    border: none;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
}
.btn-delete:hover {
    background-color: #eab308;
    color: white;
}

/* Card */
.card { border-radius: 0.75rem; }

/* Titre */
h1 { font-family: 'Segoe UI', sans-serif; }
</style>
{% endblock %}
