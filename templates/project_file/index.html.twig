{% extends 'base.html.twig' %}

{% block title %}Fichiers des projets{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des fichiers de projets</h1>
        
        <div class="btn-group" role="group">
            <a href="{{ path('app_project_file_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Ajouter un fichier
            </a>
            <a href="{{ path('app_upload') }}" class="btn btn-success">
                📤 Upload fichier
            </a>
        </div>
    </div>

    <!-- Messages flash pour les uploads -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nom du fichier</th>
                            <th>Type</th>
                            <th>Date Upload</th>
                            <th>Projet</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for file in project_files %}
                        <tr>
                            <td>{{ file.id }}</td>
                            <td>
                                <i class="fas fa-file"></i> 
                                {{ file.url|split('-')|slice(0, -1)|join('-') ?: file.url }}
                            </td>
                            <td>
                                <span class="badge bg-info">{{ file.type }}</span>
                            </td>
                            <td>{{ file.dateUpload ? file.dateUpload|date('d/m/Y H:i') : '' }}</td>
                            <td>
                                {% if file.project %}
                                    <span class="badge bg-secondary">{{ file.project.titre }}</span>
                                {% else %}
                                    <span class="text-muted">Aucun projet</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a href="{{ path('app_project_file_show', {'id': file.id}) }}" 
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    {% if file.url %}
                                        <a href="{{ path('app_project_file_download', {'id': file.id}) }}" 
                                           class="btn btn-outline-success btn-sm">
                                            <i class="fas fa-download"></i> Télécharger
                                        </a>
                                    {% endif %}
                                    <a href="{{ path('app_project_file_edit', {'id': file.id}) }}" 
                                       class="btn btn-outline-warning btn-sm">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                    <form method="post" action="{{ path('app_project_file_delete', {'id': file.id}) }}" 
                                          style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ file.id) }}">
                                        <button class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-folder-open fa-2x mb-2"></i><br>
                                Aucun fichier trouvé.
                                <br><br>
                                <a href="{{ path('app_upload') }}" class="btn btn-primary">
                                    📤 Uploader votre premier fichier
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Statistiques -->
    {% if project_files|length > 0 %}
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h5 class="card-title">📊 Statistiques</h5>
                        <p class="card-text">
                            <strong>{{ project_files|length }}</strong> fichier(s) au total
                        </p>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}