{% extends 'base.html.twig' %}

{% block title %}Profil Utilisateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="h3 mb-4 fw-bold">Profil Utilisateur</h1>

    <div class="card shadow-sm rounded-3 p-4">
        <p><strong>Email :</strong> {{ user.email }}</p>
        <p><strong>Rôles :</strong> {{ user.roles|join(', ') }}</p>
        <p><strong>Vérifié :</strong> {{ user.isVerified ? 'Oui' : 'Non' }}</p>
        <p><strong>Authentification par email :</strong> {{ user.isEmailAuthEnabled ? 'Activée' : 'Désactivée' }}</p>
    </div>

    <div class="mt-3 text-end">
        <a href="{{ path('user_edit', { id: user.id }) }}" class="btn btn-primary rounded-3 px-4 py-2">
            Modifier le profil
        </a>
    </div>

    <div class="mt-3">
        <a href="{{ path('user_index') }}" class="text-decoration-none">&larr; Retour à la liste des utilisateurs</a>
    </div>
</div>
{% endblock %}
