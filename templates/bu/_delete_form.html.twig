<form method="post" action="{{ path('app_b_u_delete', {'id': b_u.id}) }}" 
      onsubmit="return confirm('Voulez-vous vraiment supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ b_u.id) }}">
    <button class="btn btn-delete btn-sm">Supprimer</button>
</form>

<style>
/* Bouton Supprimer stylé */
.btn-delete {
    background-color: #facc15; /* jaune doux */
    color: white;
    border: none;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
    cursor: pointer;
}

.btn-delete:hover {
    background-color: #eab308; /* jaune plus foncé au hover */
    color: white;
}
</style>
