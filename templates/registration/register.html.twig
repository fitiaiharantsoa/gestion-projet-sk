{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<div class="container-fluid vh-100">
    <div class="row h-100">

        <!-- Colonne gauche avec logo -->
        <div class="col-md-6 d-none d-md-flex flex-column justify-content-center align-items-center bg-light">
            <img src="{{ asset('images/sk-logo.png') }}" alt="Logo SK"
                 style="max-width: 220px; height: auto; margin-bottom: 20px;">
            <h2 class="fw-bold">Bienvenue chez SK Groupe</h2>
            <p class="text-muted text-center" style="max-width: 300px;">
                Inscrivez-vous pour accéder à vos projets internes.
            </p>
        </div>

        <!-- Colonne droite avec formulaire -->
        <div class="col-md-6 d-flex justify-content-center align-items-center bg-white">
            <div class="card shadow-lg border-0 p-5 w-100" style="max-width: 450px; border-radius: 15px;">

                <h3 class="text-center mb-4 fw-bold">📝 Créer un compte</h3>

                {% for flash_error in app.flashes('verify_email_error') %}
                    <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                {% endfor %}

                {{ form_start(registrationForm) }}

                    <div class="form-floating mb-3">
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control rounded-3'}}) }}
                        {{ form_label(registrationForm.email, 'Adresse e-mail') }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="form-floating mb-3">
                        {{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control rounded-3'}}) }}
                        {{ form_label(registrationForm.prenom, 'Prénom') }}
                        {{ form_errors(registrationForm.prenom) }}
                    </div>

                    <div class="form-floating mb-3">
                        {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control rounded-3'}}) }}
                        {{ form_label(registrationForm.nom, 'Nom') }}
                        {{ form_errors(registrationForm.nom) }}
                    </div>

                    <div class="form-floating mb-3">
                        {{ form_widget(registrationForm.departement, {'attr': {'class': 'form-select rounded-3'}}) }}
                        {{ form_label(registrationForm.departement, 'Département') }}
                        {{ form_errors(registrationForm.departement) }}
                    </div>

                    <div class="form-floating mb-4">
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control rounded-3'}}) }}
                        {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary rounded-3 py-2 fw-bold">
                            Créer mon compte
                        </button>
                    </div>

                {{ form_end(registrationForm) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
