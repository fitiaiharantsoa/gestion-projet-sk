        <div class="" style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
            {% for task in tasks %}
            {# <tr>
                <td>{{ task.id }}</td>
                <td>{{ task.titre }}</td>
                <td>{{ task.statut }}</td>
                <td><a class="btn " href="{{ path('user_profile', {id: task.assigne.id}) }}">{{ task.assigne.nom }} {{
                        task.assigne.prenom }}</a></td>
                <td><a class="btn " href="{{ path('project_kanban', {id: task.project.id}) }}">{{ task.project.titre }}
                    </a></td>
                <td>
