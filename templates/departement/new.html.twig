{% extends 'base.html.twig' %}

{% block title %}Nouveau Département{% endblock %}

{% block body %}
<div class="form-page d-flex flex-column justify-content-center align-items-center">
    <h2 class="mb-4" style="font-size:1.5rem; font-weight:600;">Nouveau département</h2>

    <div class="form-container w-100">
        {{ include('departement/_form.html.twig', {'button_label': 'Enregistrer'}) }}
    </div>

    <div class="mt-3 text-end w-100">
        <a href="{{ path('app_departement_index') }}" class="btn btn-back">Retour</a>
    </div>
</div>

<style>
/* Page centrée */
.form-page {
    min-height: 80vh; /* pour centrer verticalement */
    padding: 2rem;
}

/* Conteneur du formulaire */
.form-container {
    max-width: 500px;
    width: 100%;
}

/* Bouton Retour */
.btn-back {
    background-color: #60a5fa; /* bleu doux */
    color: white;
    border: none;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
    text-decoration: none;
}

.btn-back:hover {
    background-color: #3b82f6;
    color: white;
}

/* Bouton Enregistrer centré */
.form-container form button {
    display: block;
    margin: 1rem auto 0 auto;
    background-color: #34d399; /* vert doux */
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
}

.form-container form button:hover {
    background-color: #10b981;
    color: white;
}
</style>
{% endblock %}
