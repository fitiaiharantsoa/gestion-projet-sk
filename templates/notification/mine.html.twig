{% extends 'base.html.twig' %}

{% block title %}Mes notifications{% endblock %}

{% block body %}
<h2 class="text-center mb-4" style="font-size:1.6rem; font-weight:600;">Mes Notifications</h2>

{% if notifications is empty %}
    <p class="text-center">Vous n'avez aucune notification.</p>
{% else %}
    <div class="list-group">
        {% for notification in notifications %}
            <div class="list-group-item d-flex justify-content-between align-items-center 
                {% if not notification.seen %}bg-red-100{% else %}bg-light{% endif %}" 
                style="border-radius: 0.5rem; margin-bottom: 0.5rem;">
                
                <div>
                    <strong>{{ notification.createdAt|date('d/m/Y H:i') }}</strong> — {{ notification.message }}
                </div>
                
                {% if not notification.seen %}
                    <span class="badge" style="background-color:#f87171; color:white; border-radius:0.5rem; padding:0.2rem 0.5rem;">Non lue</span>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}

<style>
.bg-light {
    background-color: #f3f4f6;
}

.bg-red-100 {
    background-color: #fee2e2;
}
</style>
{% endblock %}
