{% extends 'base.html.twig' %}

{% block title %}Fichiers des projets{% endblock %}

{% block body %}
<h2 class="text-center mb-4">Liste des fichiers des projets</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Nom du fichier</th>
                <th>Projet</th>
                <th>Date d'upload</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project_file in project_files %}
            <tr>
                <td>{{ project_file.id }}</td>
                <td>{{ project_file.filename }}</td>
                <td>{{ project_file.project.titre }}</td>
                <td>{{ project_file.dateUpload ? project_file.dateUpload|date('Y-m-d H:i:s') : '' }}</td>
                <td style="display: flex; gap: 5px;">
                    <a href="/uploads/file/{{ project_file.filepath }}" class="btn btn-success btn-sm" target="_blank">Voir</a>
                    {{ include('project_file/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucun fichier disponible</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="mt-3 text-end">
    <a href="{{ path('app_project_file_new') }}" class="btn btn-primary">Uploader un nouveau fichier</a>
</div>

<style>
    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        border-radius: 0.3rem;
    }
</style>
{% endblock %}
