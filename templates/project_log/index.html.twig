{% extends 'base.html.twig' %}

{% block title %}Historique des logs du projet{% endblock %}

{% block body %}
    <h1>Historique des logs du projet</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Message</th>
                <th>Utilisateur</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project_log in project_logs %}
            <tr>
                <td>{{ project_log.id }}</td>
                <td>{{ project_log.message }}</td>
                <td>{{ project_log.user ? project_log.user.fullName  : 'Anonyme' }}</td>
                <td>{{ project_log.createdAt ? project_log.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun log trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {# Suppression du lien 'Créer un nouveau log' car la route n'existe pas #}
{% endblock %}
