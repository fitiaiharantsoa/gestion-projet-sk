{{ form_start(form) }}
    {{ form_row(form.message, {'attr': {'id': 'comment-textarea'}}) }}
    <button type="submit" class="btn btn-primary">Envoyer</button>
{{ form_end(form) }}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tributejs@5.1.3/dist/tribute.css"/>
<script src="https://cdn.jsdelivr.net/npm/tributejs@5.1.3/dist/tribute.min.js"></script>

<script>
    const tribute = new Tribute({
        values: async function (text, cb) {
            const res = await fetch('/mention-users?query=' + text);
            const users = await res.json();
            cb(users); // Ex: [{ key: 'Fitia Iharantsoa', value: 'fitia' }, ...]
        }
    });

    tribute.attach(document.getElementById('comment-textarea'));
</script>
