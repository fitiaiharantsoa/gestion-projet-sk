{% extends 'base.html.twig' %}

{% block title %}Liste des départements{% endblock %}

{% block body %}
<h2 class="text-center mb-4" style="font-size:1.6rem; font-weight:600;">Liste des départements</h2>

<div class="mb-3 text-end">
    <a href="{{ path('app_departement_new') }}" class="btn btn-new">Nouveau</a>
</div>

<div class="table-responsive">
    <table class="table table-modern">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Chef</th>
                <th>Membres</th>
                <th>Projets</th>
                <th>BU</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for departement in departements %}
            <tr>
                <td>{{ departement.id }}</td>
                <td>{{ departement.nom }}</td>
                <td>{{ departement.chef }}</td>
                <td>{{ nbr_membre[departement.id] }}</td>
                <td>{{ nbr_projet[departement.id] }}</td>
                <td>{{ departement.bu.nom|default('') }}</td>
                <td>
                    <a href="{{ path('app_departement_show', {'id': departement.id}) }}" class="btn btn-view btn-sm">Voir</a>
                    <a href="{{ path('app_departement_edit', {'id': departement.id}) }}" class="btn btn-edit btn-sm">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center">Aucun département</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="pagination-container mt-4">
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            {% if current_page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_departement_index', {'page': current_page - 1}) }}">&laquo;</a>
                </li>
            {% endif %}
            {% for i in 1..total_pages %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link" href="{{ path('app_departement_index', {'page': i}) }}">{{ i }}</a>
                </li>
            {% endfor %}
            {% if current_page < total_pages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_departement_index', {'page': current_page + 1}) }}">&raquo;</a>
                </li>
            {% endif %}
        </ul>
    </nav>
</div>

<style>
/* Tableau stylé */
.table-modern {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 0.5rem;
}

.table-modern thead th {
    background-color: #f3f4f6;
    color: #0f172a;
    font-weight: 600;
    border-radius: 0.5rem;
}

.table-modern tbody tr {
    background-color: #ffffff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.08);
    transition: transform 0.2s;
}

.table-modern tbody tr:hover {
    transform: translateY(-2px);
}

.table-modern th, .table-modern td {
    padding: 0.75rem 1rem;
    vertical-align: middle;
}

/* Boutons */
.btn-new {
    background-color: #60a5fa;
    color: white;
    padding: 0.4rem 0.9rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    transition: all 0.2s;
}

.btn-new:hover {
    background-color: #3b82f6;
    color: white;
}

.btn-view {
    background-color: #34d399;
    color: white;
    border-radius: 0.5rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
}

.btn-view:hover {
    background-color: #10b981;
}

.btn-edit {
    background-color: #facc15;
    color: white;
    border-radius: 0.5rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
}

.btn-edit:hover {
    background-color: #eab308;
}

/* Pagination */
.pagination .page-item .page-link {
    border-radius: 0.5rem;
    margin: 0 2px;
    color: #0f172a;
}

.pagination .page-item.active .page-link {
    background-color: #60a5fa;
    color: white;
    border: none;
}

.pagination .page-item .page-link:hover {
    background-color: #3b82f6;
    color: white;
}
</style>
{% endblock %}
