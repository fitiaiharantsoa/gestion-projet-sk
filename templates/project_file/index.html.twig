{% extends 'base.html.twig' %}

{% block title %}ProjectFile index{% endblock %}

{% block body %}
    <h1>Listes de fichiers des projets</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom du fichier</th>
                <th>Projet</th>
                <th>Date d'upload</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project_file in project_files %}
            <tr>
                <td>{{ project_file.id }}</td>
                <td>{{ project_file.filename }}</td>
                <td>{{ project_file.projet.titre }}</td>
                <td>{{ project_file.dateUpload ? project_file.dateUpload|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    {# <a href="{{ path('app_project_file_show', {'id': project_file.id}) }}">voir</a> #}
                    <a href="/uploads/file/{{ project_file.filepath }}">voir</a>
                    <a href="{{ path('app_project_file_edit', {'id': project_file.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun fichier</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_project_file_new') }}">Uploader un nouveau fichier</a>
{% endblock %}
