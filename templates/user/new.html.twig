{# templates/user/new.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Créer un nouvel utilisateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="h3 mb-4 fw-bold">Créer un nouvel utilisateur</h1>

    <div class="card shadow-sm rounded-3 p-4">
        {{ form_start(form) }}
            <div class="row g-3">
                {% for child in form %}
                    <div class="col-12 col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
                            {{ form_label(child) }}
                            {{ form_errors(child) }}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-primary rounded-3 px-4 py-2">Enregistrer</button>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="mt-3">
        <a href="{{ path('user_index') }}" class="text-decoration-none">&larr; Retour à la liste des utilisateurs</a>
    </div>
</div>
{% endblock %}
