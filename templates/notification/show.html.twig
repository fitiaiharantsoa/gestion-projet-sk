{% extends 'base.html.twig' %}

{% block title %}Notification{% endblock %}

{% block body %}
    <h1>Notification</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ notification.id }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ notification.message }}</td>
            </tr>
            <tr>
                <th>Vu</th>
                <td>{{ notification.seen ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ notification.createdAt ? notification.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_notification_index') }}">Retour</a>

    <a href="{{ path('app_notification_edit', {'id': notification.id}) }}">Modifier</a>

    {{ include('notification/_delete_form.html.twig') }}

    
{% endblock %}
