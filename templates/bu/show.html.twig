{% extends 'base.html.twig' %}

{% block title %}BU{% endblock %}

{% block body %}
<div class="container py-4">
    <!-- Titre -->
    <h1 class="text-center text-dark mb-4" style="font-size: 1.6rem;">BU : {{ b_u.nom }}</h1>

    <!-- Table BU -->
    <div class="card shadow-sm p-3 mb-4">
        <table class="table table-borderless mb-0">
            <tbody>
                <tr>
                    <th style="width: 150px;">Id</th>
                    <td>{{ b_u.id }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ b_u.nom }}</td>
                </tr>
                <tr>
                    <th>Responsable</th>
                    <td>{{ b_u.responsable.nom }} {{ b_u.responsable.prenom }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Boutons -->
    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path('app_b_u_index') }}" class="btn btn-back btn-sm">Retour</a>
        {% if 'ROLE_PDG' in app.user.roles %}
        <a href="{{ path('app_b_u_edit', {'id': b_u.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
        {% endif %}
    </div>
</div>

<style>
/* Bouton Retour stylé */
.btn-back {
    background-color: #60a5fa;
    color: white;
    border: none;
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
}
.btn-back:hover { background-color: #3b82f6; }

/* Card */
.card { border-radius: 0.75rem; }

/* Titre */
h1 { font-family: 'Segoe UI', sans-serif; }
</style>
{% endblock %}
