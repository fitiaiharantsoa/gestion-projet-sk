{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
<style>
    .notif-container {
        margin: 2rem auto;
        max-width: 700px;
        width: 95%;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        text-align: center;
        background-color: #f9fafb;
        padding: 2rem;
        border-radius: 0.75rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .notif-container h1 {
        font-size: 1.8rem;
        color: #0f172a;
        margin-bottom: 1rem;
    }

    .notif-container ul {
        text-align: left;
        display: inline-block;
        padding-left: 1rem;
    }

    .notif-container code {
        background-color: #e5e7eb;
        padding: 2px 6px;
        border-radius: 0.25rem;
        font-family: monospace;
    }
</style>

<div class="notif-container">
    <h1>Hello {{ controller_name }}! ✅</h1>

    <p>Ce message amical provient de :</p>
    <ul>
        <li>Votre contrôleur : <code>/src/Controller/NotifController.php</code></li>
        <li>Votre template : <code>/templates/notif/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
