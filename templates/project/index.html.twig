{% extends 'base.html.twig' %}

{% block title %}Liste des projets en cours{% endblock %}

{% block body %}
<h2 class="page-title m-5" style="text-align: center;">Vos projets</h2>

{# Résumé des progressions selon rôle #}
{% if 'ROLE_PDG' in app.user.roles %}
    <div class="mb-5" style="display: flex; flex-wrap: wrap; justify-content: space-evenly;">
        <div>
            <h4>Progression globale: {{ progressionGlobale }}%</h4>
            <h5>Nombre de projet : {{ total_projet }}</h5>
            <canvas id="nbr_projet_chart"></canvas>
        </div>
        <div style="width: 350px;">
            <h4>Progression par département:</h4>
            <canvas id="chart"></canvas>
        </div>
    </div>
    
    
    {# <ul>
        {% for depId, prog in progressionParDepartement %}
            <li>Département {{ nomdep[depId] ?: 'Unassigned' }} : {{ prog }}% </li>
        {% endfor %}
    </ul> #}
{% endif %}

{% if 'ROLE_BU' in app.user.roles %}
    {% set depId = departement_user ? departement_user.id : null %}
    <h3>Your Department's Progression: {{ progressionParDepartement[depId]|default(0) }}%</h3>
{% endif %}

{% if 'ROLE_USER' in app.user.roles %}
    {% set userId = app.user.id %}
    <h3>Your Total Progression: {{ progressionParUser[userId]|default(0) }}%</h3>
{% endif %}


    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin: 5px; justify-content: space-evenly;">
        <div class="card" style="width: 18rem; height: 18rem; display: flex;  justify-content: center;  align-items: center;"> 
    
            <a class="" style="display: flex; text-decoration: none; flex-direction: column; align-items: center;" href="{{ path('app_project_new') }}"> <svg width="100" height="100" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path opacity="0.4" d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" fill="#292D32"/>
                <path d="M16 11.25H12.75V8C12.75 7.59 12.41 7.25 12 7.25C11.59 7.25 11.25 7.59 11.25 8V11.25H8C7.59 11.25 7.25 11.59 7.25 12C7.25 12.41 7.59 12.75 8 12.75H11.25V16C11.25 16.41 11.59 16.75 12 16.75C12.41 16.75 12.75 16.41 12.75 16V12.75H16C16.41 12.75 16.75 12.41 16.75 12C16.75 11.59 16.41 11.25 16 11.25Z" fill="#292D32"/>
                </svg> Nouveau projet</a>
        
    </div>
        {% for project in projects %}
            {# Calcul de la progression moyenne du projet #}
            {% set tasks = project.tasks %}
            {% set sumProgress = 0 %}
            {% set countTasks = tasks|length %}
            {% for task in tasks %}
                {% set sumProgress = sumProgress + (task.progression ?: 0) %}
            {% endfor %}
            {% set avgProgress = countTasks > 0 ? (sumProgress / countTasks)|round : 0 %}

            <div class="card" style="width: 18rem;height: 18rem;">
                <div class="card-body">
                  <h5 class="card-title"> {{ project.titre }}</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">{{ project.statut }}</h6>
                  <p class="card-text " style="min-height: 8rem;">{{ project.description }}</p>
                  <div class="progress m-2 " role="progressbar" aria-label="Basic example" aria-valuenow="{{ avgProgress }}" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: {{ avgProgress }}%">{{ avgProgress }} % </div>
                  </div>
                  <a href="{{ path('app_project_show', {'id': project.id}) }}" class="card-link">Voir</a>
                  <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="card-link">Modifier</a>
                </div>
              </div>

            
        {% else %}
            <tr>
                <td colspan="5">Aucun projet en cours.</td>
            </tr>
        {% endfor %}
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const chart_projet_element = document.getElementById("nbr_projet_chart")
    const data_nbr_projet = {
        labels: [
            'A faire',
            'En cours',
            'Bloqué',
            'Terminé'
        ],
        datasets: [{
            label: "Repartitoin des projets",
            data: ['{{ total_a_faire }}', '{{ total_encours }}', '{{ total_bloque }}', '{{ total_termine }}'],
            backgroundColor: [
                '#A4B494',
                '#BEC5AD',
                '#3B5249',
                '#519872'
            ],
            hoverOffset:4
        }]
    }
    const config_nbr_projet ={
        type: 'doughnut',
        data: data_nbr_projet,
      }
    const chart_projet = new Chart(chart_projet_element, config_nbr_projet)
    const mc = document.getElementById('chart')
    const data = {
        labels: [
            {% for depId, prog in progressionParDepartement %}
            '{{ nomdep[depId]|default('default') }}',
         {% endfor %}
        ],
        datasets: [{
          label: 'Progression par departement',
          data: [{% for depId, prog in progressionParDepartement %}
          {{ prog }},
       {% endfor %}],
          backgroundColor: [
            {% for  depId, prog in progressionParDepartement %}
          '{{ couleur[depId]|default('red') }}',
       {% endfor %}
          ],
          hoverOffset: 4
        }]
      };

      const config = {
        type: 'doughnut',
        data: data,
      };
      const myChart = new Chart(mc, config)
</script>

{% endblock %}
