<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}GestionSK{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { 
            display: flex; 
            flex-direction: column; 
            min-height: 100vh; 
        }
        main { 
            flex: 1; 
            padding: 2rem; 
        }
        header nav ul {
            list-style: none;
            display: flex;
            gap: 1rem;
            padding: 1rem;
            background-color: #60a5fa;
        }
        header nav ul li a {
            color: white;
            text-decoration: none;
            font-weight: 500;
        }
        header nav ul li a:hover {
            text-decoration: underline;
        }
        footer {
            text-align: center;
            padding: 1rem;
            background-color: #f1f1f1;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="{{ path('app_task_index') }}">Tasks</a></li>
                <li><a href="{{ path('app_project_index') }}">Projects</a></li>
                <li><a href="{{ path('user_index') }}">Users</a></li>
                {% if app.user %}
                    <li><a href="{{ path('user_profile', { id: app.user.id }) }}">Profile</a></li>
                    <li><a href="{{ path('user_logout') }}">Logout</a></li>
                {% else %}
                    <li><a href="{{ path('app_login') }}">Login</a></li>
                {% endif %}
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block body %}{% endblock %}
    </main>

    <footer>
        <p>&copy; 2025 GestionSK</p>
    </footer>
</body>
</html>
