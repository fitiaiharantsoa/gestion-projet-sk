{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container-fluid vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow-lg border-0 p-4" 
         style="width: 100%; max-width: 400px; border-radius: 15px;">

        <!-- Logo centré en haut -->
        <div class="text-center mb-4">
            <img src="{{ asset('images/sk-logo.png') }}" alt="Logo SK"
                 style="max-width: 120px; height: auto;">
        </div>

        <h3 class="text-center mb-4 fw-bold">🔐 Connexion</h3>

        {% if error %}
            <div class="alert alert-danger text-center">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="alert alert-info text-center">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }},
                <a href="{{ path('app_logout') }}">Déconnexion</a>
            </div>
        {% endif %}

        <form method="post">
            <div class="form-floating mb-3">
                <input type="email" name="_username" id="username" 
                       value="{{ last_username }}" 
                       class="form-control rounded-3" placeholder="Email" required autofocus>
                <label for="username">Email</label>
            </div>

            <div class="form-floating mb-3">
                <input type="password" name="_password" id="password" 
                       class="form-control rounded-3" placeholder="Mot de passe" required>
                <label for="password">Mot de passe</label>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <input type="hidden" name="trusted_device_token" id="trusted_device_token" value="">

            <div class="d-grid">
                <button type="submit" class="btn btn-primary rounded-3 py-2 fw-bold">
                    Se connecter
                </button>
            </div>

            <div class="mt-3 text-center">
                <a href="{{ path('app_forgot_password_request') }}" 
                   class="text-decoration-none">
                    Mot de passe oublié ?
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
